# 34. Zagrebački maraton — Sunday 11 October 2026, Trg bana Jelačića.
# Public values only (they ship to the browser). Secrets stay in Cloudflare.
# The default event: `npm run build` builds it.   Worker: zagreb-photos

NEXT_PUBLIC_SUPABASE_URL=https://gqjahxadfodnmbpetgyh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_V2b7WWbah9zCbhd2gypePQ_ovINMY1S
NEXT_PUBLIC_EVENT_SLUG=zagreb-2026
NEXT_PUBLIC_EVENT_TZ=Europe/Zagreb
NEXT_PUBLIC_SITE_URL=https://bibfind.eu
# Shown on /kontakt and /privatnost for removal and privacy requests.
NEXT_PUBLIC_CONTACT_EMAIL=contact@sklop.eu

NEXT_PUBLIC_EVENT_NAME="Zagrebački maraton"
NEXT_PUBLIC_EVENT_NAME_EN="Zagreb Marathon"
NEXT_PUBLIC_EVENT_ACCENT=Zagrebački
NEXT_PUBLIC_EVENT_EDITION=34
NEXT_PUBLIC_EVENT_CITY=Zagreb
NEXT_PUBLIC_EVENT_DATE=2026-10-11
NEXT_PUBLIC_EVENT_RACE_BADGE="4 UTRKE"
NEXT_PUBLIC_EVENT_RACE_LABEL="42,2 · 21,1 · 10 km · štafeta"
NEXT_PUBLIC_EVENT_THEME=zagreb

# Hero photos (start on Trg bana Jelačića): the first for desktop, the second
# for phones. Photos: Krume Ivanovski.
NEXT_PUBLIC_HERO_IMAGE="/brand/zagreb-hero-1.jpg,/brand/zagreb-hero-2.jpg"
# Crop anchor for each photo, same order (CSS object-position).
NEXT_PUBLIC_HERO_POSITION="50% 55%,45% 62%"
NEXT_PUBLIC_HERO_CREDIT="Foto: Krume Ivanovski"
NEXT_PUBLIC_OG_IMAGE=/brand/zagreb-og.jpg
NEXT_PUBLIC_BRAND_MARK=/brand/znak.jpg
NEXT_PUBLIC_BRAND_MARK_RATIO="336 / 400"
NEXT_PUBLIC_BRAND_ICON=/brand/znak-150.jpg
NEXT_PUBLIC_BRAND_APPLE_ICON=/brand/znak-180.jpg
NEXT_PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAFCxDpHVQwgjiD_B
# Photos for this event live in this R2 bucket (also set in wrangler.jsonc),
# created with EU jurisdiction so they stay in the EU.
R2_BUCKET=zagreb-photos
R2_JURISDICTION=eu
