# ---------------------------------------------------------------------------
# Browser-visible. Safe to ship: the anon key can only reach what RLS allows,
# which is photos/detections for published events plus two RPCs.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Which event the site shows. Matches events.slug.
NEXT_PUBLIC_EVENT_SLUG=zagreb-2026

# Photo timestamps are shown in the race's timezone, not the viewer's.
NEXT_PUBLIC_EVENT_TZ=Europe/Zagreb

# The race emblem, used as the header mark and the site icon. Defaults to the
# official site's copy; run `npm run fetch:brand` and point these at the local
# files before deploying, so the site does not hotlink someone else's server.
NEXT_PUBLIC_BRAND_MARK=/brand/znak.jpg
NEXT_PUBLIC_BRAND_ICON=/brand/znak-150.jpg

# Sales knobs (were editor props in the design file).
NEXT_PUBLIC_PRICE_SINGLE_EUR=9
NEXT_PUBLIC_PRICE_BUNDLE_EUR=39
# true = previews are watermarked and originals need unlocking.
NEXT_PUBLIC_WATERMARK=false

# ---------------------------------------------------------------------------
# Server-side only — used by the scripts/ importers, never by the app.
# Do NOT prefix with NEXT_PUBLIC_ and do not commit a filled-in value.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
