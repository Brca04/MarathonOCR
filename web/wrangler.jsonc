{
  // Static site on Cloudflare Workers, with a small guard Worker in front of
  // the search data only (worker/index.ts). Pages, scripts and photos are
  // served straight from the asset store and never invoke the Worker, so they
  // stay free and unmetered; only /data/*, /api/* and /media/* run code.
  // Event photos (/media/*) come from R2, not the asset store, so a deploy
  // never has to carry them and a GitHub-triggered build works without them.
  //
  // `name` MUST match the Worker in the dashboard, or `wrangler deploy` creates
  // a second Worker under a different *.workers.dev URL.
  "name": "zagreb-photos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/data/*", "/api/*", "/media/*"],
    // Unknown paths get the exported 404 page instead of a bare Worker error.
    "not_found_handling": "404-page"
  },
  // Event photos, uploaded by scripts/publish-photos.mjs; keys mirror the URL
  // path ("media/<event>/w/<token>.jpg").
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "zagreb-photos", "jurisdiction": "eu" }],
  // Exact per-session quota: at most BIB_QUOTA different bibs per session
  // (worker/index.ts, class SessionQuota). One small SQLite-backed Durable
  // Object per session, wiped when the session expires.
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "SessionQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionQuota"] }],
  "vars": { "BIB_QUOTA": "30" },
  // Workers Logs, Traces and Issues (same as the dashboard; keep in sync, or a
  // Git build turns them off again).
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issue_detection": { "enabled": true }
  },
  // Per-location counters (Cloudflare Rate Limiting binding). Approximate by
  // design — a first layer against floods; the exact cap is QUOTA above. Periods can only
  // be 10 or 60 seconds. A runner looks up a handful of bibs; a scraper
  // walking the whole field hits these within seconds.
  "ratelimits": [
    // Bib lookups per browser session.
    { "name": "BIB_PER_SESSION", "namespace_id": "4301", "simple": { "limit": 20, "period": 60 } },
    // Bib lookups per IP — generous, because race-day Wi-Fi puts many phones behind one address.
    { "name": "BIB_PER_IP", "namespace_id": "4302", "simple": { "limit": 300, "period": 60 } },
    // New sessions per IP. High on purpose: hundreds of phones on race-venue
    // Wi-Fi or one mobile carrier share an address; Turnstile and the
    // per-session quota are what stop scrapers.
    { "name": "SESSION_PER_IP", "namespace_id": "4303", "simple": { "limit": 300, "period": 60 } }
  ],

  // Secrets (set once, never in this file):
  //   npx wrangler secret put SESSION_SECRET     # any long random string
  //   npx wrangler secret put TURNSTILE_SECRET   # enables the bot challenge
  // Build variable (Settings -> Build -> Variables and secrets):
  //   SUPABASE_SERVICE_ROLE_KEY                  # lets the build export the search data
}
